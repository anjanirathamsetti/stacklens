{
  "name": "stacklens-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Function-level call-tree tracing for backends, with a trace analyser UI. SDKs per language under sdks/.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anjanirathamsetti/stacklens.git"
  },
  "homepage": "https://github.com/anjanirathamsetti/stacklens#readme",
  "bugs": {
    "url": "https://github.com/anjanirathamsetti/stacklens/issues"
  },
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/contract",
    "packages/shared",
    "sdks/node-tracer",
    "stacklens/backend",
    "stacklens/frontend",
    "examples/node/*"
  ],
  "scripts": {
    "build": "node scripts/dev-guard.mjs && npm run build:packages && npm run build -w stacklens/frontend",
    "build:packages": "npm run build -w @stacklens/types && npm run build -w @stacklens/node-tracer",
    "dev": "npm run build:packages && npm run dev -w stacklens/frontend",
    "start": "npm run start -w stacklens/frontend",
    "typecheck": "npm run build -w @stacklens/types && npm run typecheck --workspaces --if-present",
    "lint": "eslint . && npm run lint -w stacklens/frontend",
    "lint:fix": "eslint . --fix && npm run lint -w stacklens/frontend -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "example:express": "npm run start -w @stacklens-examples/express-basic",
    "example:nest": "npm run start -w @stacklens-examples/nestjs-typeorm",
    "example:shipping": "npm run start -w @stacklens-examples/shipping-service",
    "traffic": "node scripts/generate-traffic.mjs",
    "docker:build": "docker build -f deploy/docker/Dockerfile -t stacklens:local .",
    "clean": "rm -rf packages/*/dist sdks/*/dist stacklens/frontend/.next stacklens/frontend/.next.nosync stacklens/frontend/dist",
    "seed": "node scripts/generate-traffic.mjs --seed",
    "docker:up": "docker compose -f deploy/docker-compose.yml up --build",
    "test:backend": "npm run test -w @stacklens/backend",
    "test:sdk": "npm run test -w @stacklens/node-tracer",
    "conformance:node": "npm run build -w @stacklens/node-tracer && node sdks/conformance/node-tracer/run.mjs | node sdks/conformance/check.mjs -",
    "conformance:python": "python3 sdks/conformance/python-tracer/run.py | node sdks/conformance/check.mjs -",
    "test:python": "cd sdks/python-tracer && ${PYTHON:-python3} -m pytest -q",
    "example:python": "${PYTHON:-examples/python/.venv/bin/python} examples/python/run_all.py",
    "traffic:python": "python3 examples/python/traffic.py",
    "sample:python": "node scripts/python-sample-data.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^17.14.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.56.0"
  }
}
