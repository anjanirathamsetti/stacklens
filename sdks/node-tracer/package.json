{
  "name": "@stacklens/node-tracer",
  "version": "0.1.0",
  "description": "Drop-in call-tree tracing for Node.js backends \u2013 NestJS, Express and TypeORM",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anjanirathamsetti/stacklens.git",
    "directory": "sdks/node-tracer"
  },
  "homepage": "https://github.com/anjanirathamsetti/stacklens/tree/main/sdks/node-tracer#readme",
  "bugs": {
    "url": "https://github.com/anjanirathamsetti/stacklens/issues"
  },
  "keywords": [
    "tracing",
    "observability",
    "nestjs",
    "express",
    "typeorm",
    "call-tree",
    "apm"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@stacklens/types": "0.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "express": "^4.21.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
