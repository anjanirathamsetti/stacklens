# StackLens server configuration. Copy to .env.local (or pass as environment variables / docker -e).

# Database (PostgreSQL)
# DATABASE_URL=postgres://user:pass@host:5432/stacklens   # unset → embedded PostgreSQL in STACKLENS_DATA_DIR/pg
# STACKLENS_DB_POOL_MAX=10
# STACKLENS_DB_SSL=require                    # true | require | no-verify
# STACKLENS_RETENTION_DAYS=30                 # delete request summaries older than this

# Storage limits
# STACKLENS_DATA_DIR=~/.stacklens/data       # embedded database folder (and legacy JSON import source)
# STACKLENS_MAX_TRACES=3000                   # healthy call trees kept in memory
# STACKLENS_MAX_ERROR_TRACES=2000             # extra budget for call trees with errors
# STACKLENS_MAX_SUMMARIES=100000              # request summaries for charts / long ranges
# STACKLENS_PUBLIC_URL=https://stacklens.example.com   # used for links in incident descriptions

# ServiceNow (incidents). Without these the Incidents page runs in local demo mode.
# SERVICENOW_INSTANCE=dev12345                # or a full URL: https://acme.service-now.com
# SERVICENOW_USERNAME=stacklens.integration
# SERVICENOW_PASSWORD=
# SERVICENOW_TOKEN=                           # OAuth bearer token instead of username/password
# SERVICENOW_ASSIGNMENT_GROUP=
# SERVICENOW_CALLER_ID=
# SERVICENOW_CATEGORY=software
# SERVICENOW_CLOSE_CODE=Solution provided

# Accounts
# STACKLENS_ADMIN_EMAIL=admin@example.com      # create the first admin at startup (recommended on shared servers)
# STACKLENS_ADMIN_PASSWORD=
# STACKLENS_TRUST_PROXY=1                      # only behind a proxy that overwrites X-Forwarded-For

# AI (Admin → AI assistant)
# STACKLENS_AI_API_KEY=
