{
  "name": "stacklens",
  "version": "0.1.0",
  "description": "StackLens server: trace collector and analyser UI for Node.js backends. Run with `npx stacklens` or Docker.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anjanirathamsetti/stacklens.git",
    "directory": "stacklens/frontend"
  },
  "homepage": "https://github.com/anjanirathamsetti/stacklens/tree/main/stacklens/frontend#readme",
  "bugs": {
    "url": "https://github.com/anjanirathamsetti/stacklens/issues"
  },
  "keywords": [
    "tracing",
    "observability",
    "apm",
    "nestjs",
    "express",
    "dashboard"
  ],
  "bin": {
    "stacklens": "./bin/stacklens.mjs"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/standalone",
    "!.next/trace",
    "next.config.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "node ../../scripts/dev-guard.mjs",
    "dev": "next dev -p 4300",
    "build": "next build",
    "start": "node ./bin/stacklens.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.79.0",
    "next": "^16.0.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.11.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@stacklens/backend": "*",
    "@stacklens/shared": "*",
    "@stacklens/types": "0.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
