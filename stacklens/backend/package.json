  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@stacklens/shared": "*",
    "@stacklens/types": "0.1.0",
    "pg": "^8.23.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
