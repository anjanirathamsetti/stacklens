{
  "name": "@stacklens/backend",
  "version": "0.1.0",
  "private": true,
  "description": "StackLens app core: HTTP handlers, auth, PostgreSQL storage, repositories and services. Framework-agnostic (no React / Next.js); the frontend's API routes are thin adapters over src/http.",
