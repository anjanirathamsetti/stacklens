{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck*)",
      "Bash(npm run lint*)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm run conformance*)",
      "Bash(npm run format*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": ["Read(./dump.txt)", "Read(./**/.env)", "Read(./**/.env.local)", "Read(./**/.env.*.local)"]
  }
}
